{
  "name": "gilberto",
  "private": true,
  "version": "0.0.0",
  "description": "Personal AI-native second brain — vault + CLI",
  "license": "MIT",
  "author": "Gianluca Carucci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rucka/gilberto.git"
  },
  "homepage": "https://github.com/rucka/gilberto#readme",
  "bugs": {
    "url": "https://github.com/rucka/gilberto/issues"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "prettier": "@gilberto/prettier-config",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "prettier:check": "./tools/prettier-config/bin/prettier-check.sh '**/*.yaml' '**/*.jsonc'",
    "prettier:fix": "./tools/prettier-config/bin/prettier-fix.sh '**/*.yaml' '**/*.jsonc'",
    "mdlint:check": "./tools/markdownlint-config/bin/markdownlint-check.sh '.pair/adoption/**/*.md' '*.md'",
    "mdlint:fix": "./tools/markdownlint-config/bin/markdownlint-fix.sh '.pair/adoption/**/*.md' '*.md'",
    "ts:check": "turbo run ts:check",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "deps:outdated": "pnpm -r outdated",
    "prepare": "husky",
    "quality-gate": "echo 'quality-gate placeholder — populated in #34' && exit 0",
    "hygiene:check": "echo 'hygiene:check placeholder — populated in #34' && exit 0",
    "docs:staleness": "echo 'docs:staleness placeholder — populated in #34' && exit 0",
    "sync-deps": "echo 'sync-deps placeholder'",
    "pair:install": "pair-cli install",
    "pair:update": "pair-cli update"
  },
  "devDependencies": {
    "@foomakers/pair-cli": "catalog:",
    "@gilberto/commitlint-config": "workspace:*",
    "husky": "catalog:",
    "turbo": "catalog:"
  }
}
