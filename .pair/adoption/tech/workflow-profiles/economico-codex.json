      "model": "cheap",
      "effort": "low"
    },
    "prepare": {
      "model": "balanced",
      "effort": "medium",
      "context": "reuse"
    },
    "validate": {
      "model": "balanced",
      "effort": "high"
    },
    "implement": {
      "model": "balanced",
      "effort": "medium"
    },
    "green": {
      "model": "balanced",
      "effort": "medium",
      "context": "reuse"
    },
    "verify": {
      "model": "frontier",
      "effort": "high"
    },
    "merge": {
